group:Basics
description:Single-table practice for selection, projection, and renaming.

exampleRelAlg[[
π_{name}(
  σ_{dept = 'Engineering'}(Employee)
)
]]

exampleSql[[
SELECT name
FROM Employee
WHERE dept = 'Engineering'
]]

Employee = {
eid:number, name:string, dept:string, salary:number
1, Ana, Engineering, 95000
2, Ben, Sales, 72000
3, Cara, Engineering, 101000
4, Diego, HR, 68000
5, Eve, Sales, 75000
}

group:Joins
description:Two linked relations for natural and theta joins.

exampleRelAlg[[
π_{title, name}(
  Project ⋈ Assign
)
]]

exampleSql[[
SELECT title, name
FROM Project
NATURAL JOIN Assign
]]

Project = {
pid:number, title:string, budget:number
10, Website, 40000
20, Mobile App, 60000
30, Data Lake, 90000
}

Assign = {
pid:number, name:string, role:string
10, Ana, Lead
10, Ben, Designer
20, Cara, Lead
30, Ana, Engineer
30, Diego, Analyst
}

group:SetOps
description:Overlapping teams for union, intersect, and difference.

exampleRelAlg[[
π_{name}(
  RedTeam ∩ BlueTeam
)
]]

exampleSql[[
SELECT name FROM RedTeam
INTERSECT
SELECT name FROM BlueTeam
]]

RedTeam = {
name:string, skill:string
Alex, Python
Blair, SQL
Casey, Design
Dana, Python
}

BlueTeam = {
name:string, skill:string
Blair, SQL
Casey, Design
Ellis, Go
Alex, Python
}

group:Aggregates
description:Sales rows for grouping and aggregation (γ).

exampleRelAlg[[
γ_{region; sum(amount)→total}(Sale)
]]

exampleSql[[
SELECT region, SUM(amount) AS total
FROM Sale
GROUP BY region
]]

Sale = {
sid:number, region:string, product:string, amount:number
1, West, Widget, 120
2, East, Gadget, 80
3, West, Gadget, 150
4, East, Widget, 90
5, South, Widget, 60
6, West, Widget, 40
}

group:Library
description:Small multi-table schema for joins across authors, books, and loans.

exampleRelAlg[[
π_{title}(
  σ_{returned = 0}(
    Loan ⋈ Book
  )
)
]]

exampleSql[[
SELECT title
FROM Loan
NATURAL JOIN Book
WHERE returned = 0
]]

