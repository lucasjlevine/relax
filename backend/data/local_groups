a:number, b:string, c:string
1, a, d
2, b, d
3, c, e
4, d, f
5, d, b
}

S = {
b:string, d:number
a, 100
b, 200
c, 300
d, 400
e, 500
}

T = {
b:string, d:number
b, 100
c, 200
d, 200
}

